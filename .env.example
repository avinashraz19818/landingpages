# Port the Express app listens on (Nginx proxies to this)
PORT=3000

# Set to production on a VPS
NODE_ENV=production

# ---------------------------------------------------------------------
# NOTE: this app currently stores its runtime configuration
# (Telegram bot token, Meta CAPI token, admin password, landing page
# copy) inside data.json — not in .env. It is edited through the
# admin dashboard at /admin.
#
# See DEPLOYMENT.md section 6 for the security caveats that come with
# that design.
# ---------------------------------------------------------------------
